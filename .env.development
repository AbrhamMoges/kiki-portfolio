# Live reload / Fast Refresh (save file → browser updates)
FAST_REFRESH=true

# Native file watching often breaks on macOS with "EMFILE: too many open files".
# Polling is slightly slower CPU-wise but reliably detects saves.
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=800

# Webpack 5 (react-scripts 5) — this is the one that actually fixes many Mac setups
WATCHPACK_POLLING=true
